---
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="section-padding bg-[#F5F4F9] relative overflow-hidden">
  <div class="container-tight">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-16 items-center">

      <!-- Text side -->
      <div class="animate-on-scroll">
        <SectionLabel text="Velgørende arbejde" />

        <div class="inline-flex items-center gap-2 mb-4 bg-[#3EF48D]/15 border border-[#3EF48D]/30 rounded-full px-3 py-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#3EF48D]"></span>
          <span class="text-xs font-mono font-bold text-[#1a7a4a] tracking-wide uppercase">Gratis for non-profit</span>
        </div>

        <h2 class="font-display text-4xl md:text-5xl text-dark leading-[1.1] mb-5">
          XP-LAN –<br />
          <span class="text-primary">bygget med hjerte</span>
        </h2>

        <p class="text-dark/60 leading-relaxed mb-4">
          XP-LAN er et community-drevet gaming-event arrangeret af frivillige i Experience Esport foreningen – 600 gamere samlet til tre dages turneringer og fællesskab.
        </p>
        <p class="text-dark/60 leading-relaxed mb-8">
          Jeg byggede deres hjemmeside gratis, fordi jeg tror på at gode projekter fortjener en professionel digital tilstedeværelse – uanset budgettet.
        </p>

        <Button href="https://xp-lan.dk" variant="ghost">
          Besøg xp-lan.dk
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </Button>
      </div>

      <!-- Browser mockup -->
      <div class="animate-on-scroll delay-2">
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-dark/10">
          <!-- Chrome bar -->
          <div class="bg-[#1e1e2e] border-b border-white/10 px-4 py-3 flex items-center gap-3">
            <div class="flex gap-1.5 shrink-0" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-400/70"></span>
            </div>
            <div class="flex-1 bg-white/10 rounded-full px-3 py-1 text-xs text-white/40 border border-white/10 font-mono truncate">
              xp-lan.dk
            </div>
          </div>

          <!-- SVG mockup of xp-lan.dk -->
          <div class="aspect-[16/10] overflow-hidden">
            <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
              <!-- Background -->
              <rect width="800" height="500" fill="#07070F"/>

              <!-- Grid overlay -->
              <defs>
                <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                  <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="0.3" opacity="0.05"/>
                </pattern>
                <radialGradient id="glow1" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#7C3AED" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="#07070F" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="glow2" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.2"/>
                  <stop offset="100%" stop-color="#07070F" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="800" height="500" fill="url(#grid)"/>

              <!-- Glow effects -->
              <ellipse cx="400" cy="200" rx="350" ry="200" fill="url(#glow1)"/>
              <ellipse cx="650" cy="350" rx="200" ry="150" fill="url(#glow2)"/>

              <!-- Nav -->
              <rect width="800" height="52" fill="#07070F" opacity="0.9"/>
              <rect width="800" height="1" y="52" fill="#ffffff" opacity="0.08"/>
              <!-- Logo -->
              <text x="32" y="33" fill="white" font-size="18" font-weight="800" font-family="sans-serif" letter-spacing="2">XPL</text>
              <rect x="72" y="20" width="2" height="16" fill="#7C3AED" opacity="0.8"/>
              <text x="80" y="33" fill="#aaa" font-size="11" font-family="sans-serif">LAN 2026</text>
              <!-- Nav links -->
              <text x="480" y="32" fill="#ccc" font-size="11" font-family="sans-serif">Program</text>
              <text x="548" y="32" fill="#ccc" font-size="11" font-family="sans-serif">Om</text>
              <text x="588" y="32" fill="#ccc" font-size="11" font-family="sans-serif">FAQ</text>
              <!-- CTA -->
              <rect x="640" y="15" width="126" height="28" rx="14" fill="#7C3AED"/>
              <text x="703" y="33" text-anchor="middle" fill="white" font-size="11" font-weight="700" font-family="sans-serif">Køb billetter</text>

              <!-- Hero content -->
              <text x="400" y="115" text-anchor="middle" fill="#06B6D4" font-size="10" font-family="monospace" letter-spacing="3" opacity="0.9">EXPERIENCE ESPORT PRÆSENTERER</text>

              <!-- XPL LAN big title -->
              <text x="400" y="175" text-anchor="middle" fill="white" font-size="62" font-weight="900" font-family="sans-serif" letter-spacing="-1" opacity="0.95">XP-LAN</text>
              <text x="400" y="205" text-anchor="middle" fill="#7C3AED" font-size="15" font-weight="700" font-family="sans-serif" letter-spacing="6">2026</text>

              <!-- Tagline -->
              <text x="400" y="240" text-anchor="middle" fill="#ffffff" font-size="14" font-family="sans-serif" opacity="0.55">Danmarks Næste Store Gaming Event</text>

              <!-- Countdown boxes -->
              <rect x="220" y="268" width="68" height="56" rx="8" fill="#0f0f1a" stroke="#7C3AED" stroke-width="1" stroke-opacity="0.5"/>
              <text x="254" y="298" text-anchor="middle" fill="white" font-size="22" font-weight="800" font-family="monospace">42</text>
              <text x="254" y="316" text-anchor="middle" fill="#888" font-size="9" font-family="sans-serif">DAGE</text>

              <rect x="302" y="268" width="68" height="56" rx="8" fill="#0f0f1a" stroke="#7C3AED" stroke-width="1" stroke-opacity="0.5"/>
              <text x="336" y="298" text-anchor="middle" fill="white" font-size="22" font-weight="800" font-family="monospace">17</text>
              <text x="336" y="316" text-anchor="middle" fill="#888" font-size="9" font-family="sans-serif">TIMER</text>

              <rect x="384" y="268" width="68" height="56" rx="8" fill="#0f0f1a" stroke="#7C3AED" stroke-width="1" stroke-opacity="0.5"/>
              <text x="418" y="298" text-anchor="middle" fill="white" font-size="22" font-weight="800" font-family="monospace">33</text>
              <text x="418" y="316" text-anchor="middle" fill="#888" font-size="9" font-family="sans-serif">MIN</text>

              <rect x="466" y="268" width="68" height="56" rx="8" fill="#0f0f1a" stroke="#7C3AED" stroke-width="1" stroke-opacity="0.5"/>
              <text x="500" y="298" text-anchor="middle" fill="white" font-size="22" font-weight="800" font-family="monospace">08</text>
              <text x="500" y="316" text-anchor="middle" fill="#888" font-size="9" font-family="sans-serif">SEK</text>

              <!-- CTA buttons -->
              <rect x="256" y="344" width="152" height="36" rx="18" fill="#7C3AED"/>
              <text x="332" y="366" text-anchor="middle" fill="white" font-size="12" font-weight="700" font-family="sans-serif">Køb billetter</text>

              <rect x="422" y="344" width="126" height="36" rx="18" fill="none" stroke="#ffffff" stroke-width="1" stroke-opacity="0.25"/>
              <text x="485" y="366" text-anchor="middle" fill="#ccc" font-size="12" font-family="sans-serif">Se program</text>

              <!-- Stats bar -->
              <rect x="0" y="420" width="800" height="80" fill="#0d0d1a"/>
              <rect x="0" y="420" width="800" height="1" fill="#ffffff" opacity="0.07"/>
              <text x="200" y="454" text-anchor="middle" fill="#7C3AED" font-size="22" font-weight="800" font-family="sans-serif">600+</text>
              <text x="200" y="472" text-anchor="middle" fill="#888" font-size="10" font-family="sans-serif">GAMERE</text>
              <text x="400" y="454" text-anchor="middle" fill="#7C3AED" font-size="22" font-weight="800" font-family="sans-serif">3</text>
              <text x="400" y="472" text-anchor="middle" fill="#888" font-size="10" font-family="sans-serif">DAGE</text>
              <text x="600" y="454" text-anchor="middle" fill="#7C3AED" font-size="22" font-weight="800" font-family="sans-serif">100%</text>
              <text x="600" y="472" text-anchor="middle" fill="#888" font-size="10" font-family="sans-serif">FRIVILLIGT</text>
            </svg>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
