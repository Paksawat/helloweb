---
---

<section class="pt-12 md:pt-16 pb-24 md:pb-32 bg-white">
  <div class="container-tight">
    <div class="animate-on-scroll max-w-3xl mx-auto rounded-2xl bg-[#F5F4F9] border border-primary/10 px-8 py-10 sm:px-12 sm:py-12">

      <div class="flex items-start gap-4 mb-6">
        <div class="shrink-0 w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h3 class="font-display text-xl sm:text-2xl text-dark leading-snug mb-2">
            Vi passer din hjemmeside – også efter den er lanceret
          </h3>
          <p class="text-dark/60 leading-relaxed">
            Mange webbureauer bygger en hjemmeside og sender en faktura. Hos HelloWeb fortsætter samarbejdet. Vi sørger for drift, sikkerhed og løbende opdateringer, så din hjemmeside altid fungerer.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 sm:divide-x sm:divide-primary/10 pt-6 border-t border-primary/10">
        <div class="flex items-center gap-3 sm:justify-center py-3 sm:py-0 sm:px-6 sm:first:pl-0 sm:last:pr-0">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <span class="text-sm font-medium text-dark">Stabil drift</span>
        </div>
        <div class="flex items-center gap-3 sm:justify-center py-3 sm:py-0 sm:px-6">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span class="text-sm font-medium text-dark">Sikkerhedsopdateringer</span>
        </div>
        <div class="flex items-center gap-3 sm:justify-center py-3 sm:py-0 sm:px-6 sm:last:pr-0">
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
          </div>
          <span class="text-sm font-medium text-dark">Løbende opdateringer</span>
        </div>
      </div>

    </div>
  </div>
</section>
